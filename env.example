# =====================================================================
#  Interventions C2RMF — configuration (copier en .env puis compléter)
#  Après toute modification :  docker compose up -d
# =====================================================================

# --- Application -------------------------------------------------------
# Clé secrète : générer avec   openssl rand -base64 48
DJANGO_SECRET_KEY=A_REMPLACER
DJANGO_DEBUG=0
# Nom DNS attribué par la DSI + adresse IP de la VM, séparés par des virgules
DJANGO_ALLOWED_HOSTS=interventions.A_REMPLACER,10.0.0.10
# Mettre l'adresse complète si vous passez par un autre nom que le nom DNS (sinon laisser vide)
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 = ajoute quelques interventions d'exemple sur la semaine en cours (pour tester l'écran)
DONNEES_EXEMPLE=1
GUNICORN_WORKERS=3

# --- Filtrage des accès par plage IP ------------------------------------
# Plages autorisées, séparées par des virgules (notation CIDR).
# Vide = pas de filtrage (à éviter hors des tout premiers tests).
# Exemple : RESEAUX_AUTORISES=10.21.4.0/24,10.21.5.0/24,10.80.0.0/16
RESEAUX_AUTORISES=

# Réseau interne Docker entre Nginx et l'application. Ne changer que s'il chevauche
# un réseau du ministère (dans ce cas, choisir une autre plage privée libre).
RESEAU_DOCKER=172.31.250.0/24

# --- Ports publiés sur la VM -------------------------------------------
PORT_HTTP=80
PORT_MAILPIT=8025

# --- Base de données (conteneur PostgreSQL) ---------------------------
POSTGRES_DB=interventions
POSTGRES_USER=interventions
# générer avec   openssl rand -hex 24
POSTGRES_PASSWORD=A_REMPLACER

# --- Messagerie --------------------------------------------------------
# MODE TEST : tous les e-mails sont captés par Mailpit (http://<VM>:8025)
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Interventions C2RMF <ne-pas-repondre@culture.gouv.fr>
# Accès à la boîte de test Mailpit
MAILPIT_UTILISATEUR=test
MAILPIT_MOT_DE_PASSE=A_REMPLACER

# MODE RÉEL avec le compte générique Culture (remplacer le bloc ci-dessus) :
# EMAIL_HOST=<serveur fourni par la messagerie>
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=<identifiant du compte générique>
# EMAIL_HOST_PASSWORD=<mot de passe du compte générique>
# DEFAULT_FROM_EMAIL=Interventions C2RMF <adresse.du.compte@culture.gouv.fr>

# --- Règles --------------------------------------------------------------
DOMAINES_EMAIL_AUTORISES=culture.gouv.fr
CONNEXION_ESSAIS_MAX=5
CONNEXION_BLOCAGE_MINUTES=15
ECRAN_RAFRAICHISSEMENT_SECONDES=300
# Passer à 1 quand Nginx servira l'application en HTTPS
HTTPS_ACTIF=0
