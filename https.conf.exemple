# À copier en docker/https.conf une fois le certificat fourni par la DSI,
# puis décommenter le montage correspondant dans docker-compose.yml.
server {
    listen 443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/interventions.crt;   # certificat + chaîne de la DSI
    ssl_certificate_key /etc/nginx/certs/interventions.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:TLS:10m;

    client_max_body_size 3m;
    server_tokens off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;

    location / {
        proxy_pass http://appli;
        proxy_set_header Host $http_host;      # conserve le port : nécessaire au contrôle CSRF si PORT_HTTP ≠ 80
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 60s;
    }
}
